{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true,
    "rootDir": "src"
  },
  "include": [
    "src"
  ]
}
